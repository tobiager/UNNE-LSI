      "seed": 765568970,
      "version": 681,
      "versionNonce": 284052426,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1710654102233,
      "link": null,
      "locked": false,
      "text": "Por definición:\nE(p) = 0/4*1/16 + 1/4*1/16 + 2/4*3/8 + 3/4*1/4 + 4/4*1/16 =\n     = 0 + 1/64 + 3/16 + 3/16 + 1/16 = 29/64 =  0,453125\n\nVar(p) = 0/4^2*1/16 + 1/4^2*1/16 + 2/4^2*3/8 + 3/4^2*1/4 + 4/4^2*1/16 - (29/64)\n       = 0 + 1/256 + 3/32 + 9/64 + 1/16 - 841/4096 = 77/256 - 841/4096\n       = 391/4096 = 0,095458984\n",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por definición:\nE(p) = 0/4*1/16 + 1/4*1/16 + 2/4*3/8 + 3/4*1/4 + 4/4*1/16 =\n     = 0 + 1/64 + 3/16 + 3/16 + 1/16 = 29/64 =  0,453125\n\nVar(p) = 0/4^2*1/16 + 1/4^2*1/16 + 2/4^2*3/8 + 3/4^2*1/4 + 4/4^2*1/16 - (29/64)\n       = 0 + 1/256 + 3/32 + 9/64 + 1/16 - 841/4096 = 77/256 - 841/4096\n       = 391/4096 = 0,095458984\n",
      "lineHeight": 1.25
    },

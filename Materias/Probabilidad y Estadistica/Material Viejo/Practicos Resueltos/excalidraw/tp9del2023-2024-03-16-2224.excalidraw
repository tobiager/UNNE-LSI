    {
      "id": "0m6a4L2rL64Xl5EFJ0eRo",
      "type": "text",
      "x": -163.39586517718237,
      "y": 4807.972586403871,
      "width": 1181.5157470703125,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

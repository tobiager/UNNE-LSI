    {
      "id": "VOsSc6zYPLsuWJVG78bib",
      "type": "text",
      "x": 2995.923023577297,
      "y": 9920.63848349766,
      "width": 1518.327392578125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

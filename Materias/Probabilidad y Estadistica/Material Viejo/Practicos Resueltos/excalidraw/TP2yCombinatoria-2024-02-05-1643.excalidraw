    {
      "type": "text",
      "version": 461,
      "versionNonce": 1994933939,
      "isDeleted": false,
      "id": "fC7mdf71YDvi1g7E_Lzym",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3018.1386510151897,
      "y": 7297.309069929068,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1341.25146484375,
      "height": 405,
      "seed": 1971395308,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1709072142196,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "10% fallas del equipo\n5% fallas del equipo y errores de los operadores\n40% de errores de operadores\nE: falla el equipo; P(E) = 0,1 => P(E') = 1 - P(E) = 1 - 0,1 = 0,9\nO: falla de los operadores; P(O) = 0,4 => P(O') = 1 - P(O) = 1 - 0,4 = 0,6\na) P(E) + P(O) = 0,5\nb) P(O) - P(E∩O) = 0,4 - 0,05 = 0,35\nc) 1 - [P(O) + P(E)] = 1 - 0,5 = 0,5\nd) P(O/E') = P(O∩E')/P(E')",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "10% fallas del equipo\n5% fallas del equipo y errores de los operadores\n40% de errores de operadores\nE: falla el equipo; P(E) = 0,1 => P(E') = 1 - P(E) = 1 - 0,1 = 0,9\nO: falla de los operadores; P(O) = 0,4 => P(O') = 1 - P(O) = 1 - 0,4 = 0,6\na) P(E) + P(O) = 0,5\nb) P(O) - P(E∩O) = 0,4 - 0,05 = 0,35\nc) 1 - [P(O) + P(E)] = 1 - 0,5 = 0,5\nd) P(O/E') = P(O∩E')/P(E')",
      "lineHeight": 1.25,
      "baseline": 392
    },

    {
      "type": "text",
      "version": 671,
      "versionNonce": 508411773,
      "isDeleted": false,
      "id": "Y8Z8XP6oKX-8Clsm3klve",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3049.4042983248714,
      "y": -4352.3106995152975,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "width": 1258.8475341796875,
      "height": 630,
      "seed": 2142325642,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1709072142052,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "Respuesta si importa el orden:\na) S1 = {25, 40, 60, 75}\nb) S2 = {(75,60); (75,40); (75,25); (60,75); (60,40); (60,25); (40,75); \n(40,60); (40,25); (25,75); (25,60); (25,40); }\nc) S3 = {(75,75); (75,60); (75,40); (75,25); (60,75); (60,60); (60,40); \n(60,25); (40,75); (40,60); (40,40); (40,25); (25,75); (25,60); \n(25,40); (25,25)}\nc) Significa que no pueden salir 2 al mismo tiempo por lo que\n  S4 = S3 - {(75, 75), (60, 60), (40, 40), (25, 25)}\ne) {(75, 60, 40), (75, 60, 25), (75, 40, 60), (75, 40, 25), \n(75, 25, 60), (75, 25, 40), (60, 75, 40), ...}\nRespuesta Correcta (no importa el orden independientemente de si \nse escriben con pares ordenados):\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Respuesta si importa el orden:\na) S1 = {25, 40, 60, 75}\nb) S2 = {(75,60); (75,40); (75,25); (60,75); (60,40); (60,25); (40,75); \n(40,60); (40,25); (25,75); (25,60); (25,40); }\nc) S3 = {(75,75); (75,60); (75,40); (75,25); (60,75); (60,60); (60,40); \n(60,25); (40,75); (40,60); (40,40); (40,25); (25,75); (25,60); \n(25,40); (25,25)}\nc) Significa que no pueden salir 2 al mismo tiempo por lo que\n  S4 = S3 - {(75, 75), (60, 60), (40, 40), (25, 25)}\ne) {(75, 60, 40), (75, 60, 25), (75, 40, 60), (75, 40, 25), \n(75, 25, 60), (75, 25, 40), (60, 75, 40), ...}\nRespuesta Correcta (no importa el orden independientemente de si \nse escriben con pares ordenados):\n",
      "lineHeight": 1.25,
      "baseline": 617
    },

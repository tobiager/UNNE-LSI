    {
      "id": "axDfr1LoVS7116bf0n96U",
      "type": "text",
      "x": 452.2031450898503,
      "y": 4571.612472234148,
      "width": 919.5194091796875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1172023310,
      "version": 578,
      "versionNonce": 481733198,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709262553921,
      "link": null,
      "locked": false,
      "text": "H: el adulto es hombre; P(H) = 88/200 = 0,44 = 11/25 => P(H') = 1 - 0,44 = 0,56\nM: el adulto es mujer; P(M) = 112/200 = 0,56 = 14/25 => P(M') = 1 - 0,56 = 0,44\nI: el adulto tiene educación primaria; P(I) = 83/200 = 0,415 => P(I') = 1 - 0,415 = 0,585\nS: el adulto tiene educación secundaria; P(S) = 78/200 = 0,39 => P(S') = 1 - 0,39 = 0,61\nT: el adulto tiene educación tercería; P(T) = 39/200 = 0,195 => P(T') = 1 - 0,195 = 0,805\nP(H∩I) = 38/200 = 0,19 ; P(M∩I) = 45/200 = 0,225\nP(H∩S) = 28/200 = 0,14 ; P(M∩S) = 50/200 = 0,25\nP(H∩T) = 22/200 = 0,11 ; P(M∩T) = 17/200 = 0,085\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 218,
      "containerId": null,
      "originalText": "H: el adulto es hombre; P(H) = 88/200 = 0,44 = 11/25 => P(H') = 1 - 0,44 = 0,56\nM: el adulto es mujer; P(M) = 112/200 = 0,56 = 14/25 => P(M') = 1 - 0,56 = 0,44\nI: el adulto tiene educación primaria; P(I) = 83/200 = 0,415 => P(I') = 1 - 0,415 = 0,585\nS: el adulto tiene educación secundaria; P(S) = 78/200 = 0,39 => P(S') = 1 - 0,39 = 0,61\nT: el adulto tiene educación tercería; P(T) = 39/200 = 0,195 => P(T') = 1 - 0,195 = 0,805\nP(H∩I) = 38/200 = 0,19 ; P(M∩I) = 45/200 = 0,225\nP(H∩S) = 28/200 = 0,14 ; P(M∩S) = 50/200 = 0,25\nP(H∩T) = 22/200 = 0,11 ; P(M∩T) = 17/200 = 0,085\n",

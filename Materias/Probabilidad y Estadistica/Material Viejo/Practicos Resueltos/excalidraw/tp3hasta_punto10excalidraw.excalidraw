      "isDeleted": false,
      "boundElements": null,
      "updated": 1709262553920,
      "link": null,
      "locked": false,
      "text": "A: la industria se localiza en Argentina; P(A) = 0,7 => P(A') = 1 - P(A) = 1 - 0,7 = 0,3 \nB: \"                         \" Brasil;  P(B) = 0,4 => P(B') = 0,6\nP(A∪B) = 0,8\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 93,
      "containerId": null,
      "originalText": "A: la industria se localiza en Argentina; P(A) = 0,7 => P(A') = 1 - P(A) = 1 - 0,7 = 0,3 \nB: \"                         \" Brasil;  P(B) = 0,4 => P(B') = 0,6\nP(A∪B) = 0,8\n",
      "lineHeight": 1.25
    },

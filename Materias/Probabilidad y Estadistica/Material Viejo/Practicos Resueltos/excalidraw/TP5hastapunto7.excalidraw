    {
      "type": "text",
      "version": 419,
      "versionNonce": 1451567715,
      "isDeleted": false,
      "id": "IupVHO_ApDxjv_fJhO-tP",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 277.7642402531884,
      "y": 7811.173531595428,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1035.6356201171875,
      "height": 280,
      "seed": 1860967759,
      "groupIds": [],

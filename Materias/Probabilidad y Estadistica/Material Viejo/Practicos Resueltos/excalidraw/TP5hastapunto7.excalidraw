    {
      "type": "text",
      "version": 1675,
      "versionNonce": 1967134925,
      "isDeleted": false,
      "id": "pgh5ovvQdR4RLsLT93JDQ",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",

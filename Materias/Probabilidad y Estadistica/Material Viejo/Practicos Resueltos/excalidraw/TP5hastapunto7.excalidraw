      "fontSize": 28,
      "fontFamily": 1,
      "text": "= E[(X - E[X])^0 (Y -E[Y])^1] = Y(X) =\n= -2*6/15 + 3*9/15 \n= -4/5 + 9/5 = 1",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "= E[(X - E[X])^0 (Y -E[Y])^1] = Y(X) =\n= -2*6/15 + 3*9/15 \n= -4/5 + 9/5 = 1",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 500,
      "versionNonce": 16410275,
      "isDeleted": false,
      "id": "mLQlYIx-bMZvjv-Rbn2ru",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

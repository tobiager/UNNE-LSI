    {
      "type": "text",
      "version": 388,
      "versionNonce": 473299117,
      "isDeleted": false,
      "id": "UBNpF4HTWQnyFDoCaJY1k",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 278.92502482090174,
      "y": 11787.164225619901,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1011.1356811523438,
      "height": 595,
      "seed": 1738455322,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1709822978122,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 1,
      "text": "X: v.a. que indica si a ocurrido el suceso A con 1, cero en caso contrario\nY: v.a. que indica si a ocurrido el suceso B con 1, cero en caso contrario\n\nP(A) = 1/4 => P(A') = 3/4\nP(A/B) = 1/2 => P(A'/B) = 1 - P(A/B) = 1/2 \nP(B/A) = 1/2 => P(B'/A) = 1 - P(B/A) = 1/2\n\n00, 01, 10, 11\n\nP(X=0;Y=0) = P(A'∩B') = P(B'/A')*P(A') =\n\nP(X=0;Y=1) =  P(A'∩B) = P(B/A')*P(A') = *3/4\n\nP(X=1;Y=0) = P(A∩B') = P(B'/A)*P(A) = 1/2*1/2 = 1/4 = 0,25\n\nP(X=1;Y=1) = P(A∩B) = P(B/A)*P(A) = 1/4*1/2 = 1/8 = 0,125\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "X: v.a. que indica si a ocurrido el suceso A con 1, cero en caso contrario\nY: v.a. que indica si a ocurrido el suceso B con 1, cero en caso contrario\n\nP(A) = 1/4 => P(A') = 3/4\nP(A/B) = 1/2 => P(A'/B) = 1 - P(A/B) = 1/2 \nP(B/A) = 1/2 => P(B'/A) = 1 - P(B/A) = 1/2\n\n00, 01, 10, 11\n\nP(X=0;Y=0) = P(A'∩B') = P(B'/A')*P(A') =\n\nP(X=0;Y=1) =  P(A'∩B) = P(B/A')*P(A') = *3/4\n\nP(X=1;Y=0) = P(A∩B') = P(B'/A)*P(A) = 1/2*1/2 = 1/4 = 0,25\n\nP(X=1;Y=1) = P(A∩B) = P(B/A)*P(A) = 1/4*1/2 = 1/8 = 0,125\n",
      "lineHeight": 1.25
    },
